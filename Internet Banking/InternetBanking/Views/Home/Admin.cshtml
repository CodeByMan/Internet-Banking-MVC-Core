@model InternetBanking.Core.Application.ViewModels.Dashboard.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <div>
        <span class="badge badge-soft brand mb-2">Admin control center</span>
        <h1>Banking operations dashboard</h1>
        <p>Monitor customers, assigned products, payment throughput, and platform activity from one enterprise-style workspace.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="User" asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus-fill me-2"></i>Create User</a>
        <a asp-controller="User" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-people-fill me-2"></i>Manage Users</a>
    </div>
</div>

<div class="metric-grid mb-4">
    <article class="metric-card">
        <div class="metric-card-head">
            <div>
                <div class="metric-label">Transactions</div>
                <div class="metric-value">@Model.TotalTransactionsMade</div>
            </div>
            <div class="metric-icon"><i class="bi bi-arrow-left-right"></i></div>
        </div>
        <div class="metric-subtitle">@Model.TransactionsMadeLast24Hours recorded in the last 24 hours.</div>
    </article>

    <article class="metric-card">
        <div class="metric-card-head">
            <div>
                <div class="metric-label">Payments</div>
                <div class="metric-value">@Model.TotalPaymentsMade</div>
            </div>
            <div class="metric-icon"><i class="bi bi-send-check"></i></div>
        </div>
        <div class="metric-subtitle">@Model.PaymentsMadeLast24Hours payment operations in the last 24 hours.</div>
    </article>

    <article class="metric-card">
        <div class="metric-card-head">
            <div>
                <div class="metric-label">Active users</div>
                <div class="metric-value">@Model.TotalActiveUsers</div>
            </div>
            <div class="metric-icon"><i class="bi bi-person-check-fill"></i></div>
        </div>
        <div class="metric-subtitle">@Model.TotalInactiveUsers currently inactive user profiles.</div>
    </article>

    <article class="metric-card">
        <div class="metric-card-head">
            <div>
                <div class="metric-label">Products issued</div>
                <div class="metric-value">@Model.TotalProductsCreated</div>
            </div>
            <div class="metric-icon"><i class="bi bi-credit-card-2-front-fill"></i></div>
        </div>
        <div class="metric-subtitle">Savings accounts, credit cards, and loan products assigned.</div>
    </article>
</div>

<div class="dashboard-grid">
    <div class="dashboard-column">
        <section class="card app-card">
            <div class="card-body p-4">
                <div class="card-title-row">
                    <div>
                        <h3>Recent platform activity</h3>
                        <p>Latest payments and transfers created across the banking workspace.</p>
                    </div>
                    <span class="badge badge-soft brand">Live feed</span>
                </div>

                <div class="data-table-wrap">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Source</th>
                                <th>Destination</th>
                                <th>Description</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentActivity.Any())
                            {
                                @foreach (var item in Model.RecentActivity)
                                {
                                    <tr>
                                        <td>@(item.Created?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                                        <td><span class="badge badge-soft brand">@item.PaymentType.GetDisplayName()</span></td>
                                        <td class="table-highlight">@item.SourceAccountNumber</td>
                                        <td>@item.DestinationAccountNumber</td>
                                        <td>@item.Description</td>
                                        <td class="text-end fw-semibold">@item.Amount.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="empty-state">
                                            <strong>No activity available yet.</strong>
                                            <div class="text-secondary mt-2">Create users and execute payments to populate this feed.</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <aside class="dashboard-sidebar">
        <section class="card app-card">
            <div class="card-body p-4">
                <div class="card-title-row">
                    <div>
                        <h3>Operational summary</h3>
                        <p>Current system totals from user and product records.</p>
                    </div>
                </div>
                <div class="quick-list">
                    <div class="quick-item">
                        <small>Active users</small>
                        <strong>@Model.TotalActiveUsers accounts</strong>
                    </div>
                    <div class="quick-item">
                        <small>Inactive users</small>
                        <strong>@Model.TotalInactiveUsers accounts</strong>
                    </div>
                    <div class="quick-item">
                        <small>Products issued</small>
                        <strong>@Model.TotalProductsCreated products</strong>
                    </div>
                </div>
            </div>
        </section>

        <section class="card app-card">
            <div class="card-body p-4">
                <div class="card-title-row">
                    <div>
                        <h3>Quick actions</h3>
                        <p>Common admin workflows.</p>
                    </div>
                </div>
                <div class="quick-list">
                    <a class="quick-item" asp-controller="User" asp-action="Create">
                        <small>Customer onboarding</small>
                        <strong>Create a new client account</strong>
                    </a>
                    <a class="quick-item" asp-controller="User" asp-action="Index">
                        <small>Access lifecycle</small>
                        <strong>Review active and inactive users</strong>
                    </a>
                    <a class="quick-item" asp-controller="Home" asp-action="Admin">
                        <small>Operations overview</small>
                        <strong>Refresh platform totals and recent activity</strong>
                    </a>
                </div>
            </div>
        </section>
    </aside>
</div>
