@model InternetBanking.Core.Application.ViewModels.Payment.SavePaymentViewModel
@{
    ViewData["Title"] = "Credit Card Payment";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-6">
        <div class="card card-box-shadow border-0">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h1 class="h4 mb-1">Credit card payment</h1>
                <p class="text-secondary mb-0">Pay down one of your credit card balances using an available account.</p>
            </div>
            <div class="card-body px-4 pb-4">
                @if (Model.Products == null || Model.Products.Count == 0)
                {
                    <div class="alert alert-warning mb-0">No products are available for this client yet.</div>
                }
                else
                {
                    @if (Model.HasError)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <p class="mb-0">@Model.Error</p>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                    <form method="post" asp-controller="Payment" asp-action="CreditCardPayment">
                    <input type="hidden" asp-for="SubmissionToken" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="SourceAccountNumber" class="form-label"></label>
                            <select asp-for="SourceAccountNumber" class="form-select">
                                <option value="">Select a source account</option>
                                @foreach (var product in Model.Products)
                                {
                                    <option value="@product.AccountNumber">@($"{product.ProductType.GetDisplayName()} [{product.AccountNumber}]")</option>
                                }
                            </select>
                            <span asp-validation-for="SourceAccountNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DestinationAccountNumber" class="form-label">Credit Card</label>
                            <select asp-for="DestinationAccountNumber" class="form-select">
                                <option value="">Select a credit card</option>
                                @foreach (var product in Model.CreditCardsProducts ?? new List<InternetBanking.Core.Application.ViewModels.Product.ProductViewModel>())
                                {
                                    <option value="@product.AccountNumber">@($"{product.ProductType.GetDisplayName()} [{product.AccountNumber}]")</option>
                                }
                            </select>
                            <span asp-validation-for="DestinationAccountNumber" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Amount" class="form-label"></label>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" />
                            <span asp-validation-for="Amount" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Cancel</a>
                            <button class="btn btn-primary">Submit Payment</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
