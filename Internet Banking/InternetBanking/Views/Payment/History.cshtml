@model List<InternetBanking.Core.Application.ViewModels.Payment.TransactionHistoryItemViewModel>
@{
    ViewData["Title"] = "Activity History";
}

<div class="page-header">
    <div>
        <span class="badge badge-soft brand mb-2">Transaction log</span>
        <h1>Activity history</h1>
        <p>Review recent transfers and payments affecting this client profile with a more presentable fintech-style transaction table.</p>
    </div>
    <div class="page-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back to Dashboard</a>
    </div>
</div>

<section class="card app-card">
    <div class="card-body p-4">
        <div class="data-table-wrap">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Direction</th>
                        <th>Source Account</th>
                        <th>Destination Account</th>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(item.Created?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td>
                                <td><span class="badge badge-soft brand">@item.PaymentType.GetDisplayName()</span></td>
                                <td>@item.Direction</td>
                                <td class="table-highlight">@item.SourceAccountNumber</td>
                                <td>@item.DestinationAccountNumber</td>
                                <td>@item.Description</td>
                                <td class="text-end fw-semibold">@item.Amount.ToString("C")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <strong>No transactions recorded yet.</strong>
                                    <div class="text-secondary mt-2">Use any payment or transfer workflow to populate the activity ledger.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>
