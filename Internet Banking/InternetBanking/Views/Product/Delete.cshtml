@using InternetBanking.Core.Application.Enums
@model InternetBanking.Core.Application.ViewModels.Product.SaveProductViewModel
@{
    bool transferAmount = Model.ProductType == ProductType.SavingAccount && Model.Amount > 0;
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center mt-4">
    <div class="col-lg-6 col-xl-5">
        <div class="card app-card">
            <div class="card-body p-4 p-lg-5">
                <div class="confirm-panel">
                    <span class="badge badge-soft error mb-3">Delete product</span>
                    <h1 class="h4 mb-3">Delete product @Model.AccountNumber</h1>
                    <p class="text-secondary mb-0">
                        @(transferAmount
                            ? "Deleting this savings account will automatically move its remaining balance to the primary savings account."
                            : "Are you sure you want to delete this product?")
                    </p>
                </div>
                <form method="post" asp-controller="Product" asp-action="DeleteProduct" class="mt-4">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserId" />
                    <div class="d-flex justify-content-end gap-2 flex-wrap">
                        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-userId="@Model.UserId">Cancel</a>
                        <button type="submit" class="btn btn-primary">Delete Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
